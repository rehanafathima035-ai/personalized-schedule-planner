# Copy to .env and fill in. Never commit the filled-in file.

# --- MySQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=life_planner
DB_USER=changeme
DB_PASSWORD=changeme

# --- Spring Boot -----------------------------------------------------
SERVER_PORT=8080
# At least 32 characters. Generate with: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_VALIDITY_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Planner service -------------------------------------------------
PLANNER_BASE_URL=http://localhost:8001
PLANNER_TIMEOUT_SECONDS=10

# --- Optional external AI provider -----------------------------------
# Left blank on purpose. With no key the deterministic parser is used,
# which is a real fallback, not a stub.
LLM_PROVIDER=
LLM_API_KEY=

# --- Frontend --------------------------------------------------------
VITE_API_BASE=http://localhost:8080
